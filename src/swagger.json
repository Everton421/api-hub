{
  "openapi": "3.0.0",
  "info": {
    "title": "API Template",
    "description": "API REST para gerenciamento de produtos, clientes, pedidos e integrações",
    "version": "1.0.0",
    "contact": {
      "email": "suporte@intersig.com.br"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000/v1",
      "description": "Servidor de desenvolvimento"
    },
    {
      "url": "https://api.example.com/v1",
      "description": "Servidor de produção"
    }
  ],
  "tags": [
    {
      "name": "produtos",
      "description": "Operações relacionadas a produtos"
    },
    {
      "name": "clientes",
      "description": "Operações relacionadas a clientes"
    },
    {
      "name": "categorias",
      "description": "Operações relacionadas a categorias de produtos"
    },
    {
      "name": "marcas",
      "description": "Operações relacionadas a marcas de produtos"
    },
    {
      "name": "servicos",
      "description": "Operações relacionadas a serviços"
    },
    {
      "name": "veiculos",
      "description": "Operações relacionadas a veículos"
    },
    {
      "name": "formas de pagamento",
      "description": "Operações relacionadas a formas de pagamento"
    },
    {
      "name": "tipos de os",
      "description": "Operações relacionadas a tipos de ordem de serviço"
    },
    {
      "name": "pedidos",
      "description": "Operações relacionadas a pedidos"
    },
    {
      "name": "empresa",
      "description": "Operações relacionadas a empresas"
    },
    {
      "name": "autenticacao",
      "description": "Operações de autenticação e autorização"
    },
    {
      "name": "usuarios",
      "description": "Operações relacionadas a usuários"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/endpoint-exemplo": {
      "get": {
        "summary": "Resumo do endpoint",
        "description": "Descrição detalhada do que o endpoint faz",
        "tags": [
          "tag-do-dominio"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "parametro",
            "in": "query",
            "description": "Descrição do parâmetro",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/LimitParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entidade"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "summary": "Criar novo recurso",
        "description": "Descrição do POST",
        "tags": [
          "tag-do-dominio"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntidadeInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Recurso criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entidade"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "put": {
        "summary": "Atualizar recurso",
        "description": "Descrição do PUT",
        "tags": [
          "tag-do-dominio"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntidadeInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recurso atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entidade"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "summary": "Excluir recurso",
        "description": "Descrição do DELETE",
        "tags": [
          "tag-do-dominio"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do recurso",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recurso excluído com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Autenticar usuário",
        "description": "Realiza autenticação e retorna token JWT",
        "tags": [
          "autenticacao"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email do usuário"
                  },
                  "senha": {
                    "type": "string",
                    "format": "password",
                    "description": "Senha do usuário"
                  }
                },
                "required": [
                  "email",
                  "senha"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticação realizada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token JWT para autenticação"
                    },
                    "usuario": {
                      "type": "object",
                      "description": "Dados do usuário autenticado"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/enviar_codigo": {
      "post": {
        "summary": "Enviar código de validação",
        "description": "Envia código de validação para recuperação de senha",
        "tags": [
          "autenticacao"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email para envio do código"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Código enviado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/alterar_senha": {
      "post": {
        "summary": "Alterar senha",
        "description": "Altera a senha do usuário usando código de validação",
        "tags": [
          "autenticacao"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "codigo": {
                    "type": "string",
                    "description": "Código de validação recebido por email"
                  },
                  "nova_senha": {
                    "type": "string",
                    "format": "password",
                    "minLength": 6
                  }
                },
                "required": [
                  "email",
                  "codigo",
                  "nova_senha"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Senha alterada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/offline/produtos": {
      "get": {
        "summary": "Buscar todos os produtos (offline)",
        "description": "Rota responsável por buscar todos os dados dos produtos para sincronização offline",
        "tags": [
          "produtos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de produtos retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Produto"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/produtos": {
      "get": {
        "summary": "Buscar produtos com filtros",
        "description": "Obtém produtos com base em parâmetros de busca",
        "tags": [
          "produtos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "codigo",
            "in": "query",
            "description": "Código do produto",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "marca",
            "in": "query",
            "description": "Código da marca",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Grupo",
            "in": "query",
            "description": "Código da categoria",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Descrição",
            "in": "query",
            "description": "Descrição do produto (busca parcial)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/LimitParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Produtos encontrados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Produto"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/produto/{codigo-produto}": {
      "get": {
        "summary": "Buscar produto por código",
        "description": "Obtém um produto específico com todos os dados pelo código",
        "tags": [
          "produtos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "codigo-produto",
            "in": "path",
            "required": true,
            "description": "Código do produto",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Produto encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Produto"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/produto": {
      "post": {
        "summary": "Cadastrar novo produto",
        "description": "Cria um novo produto no sistema",
        "tags": [
          "produtos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProdutoInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Produto cadastrado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Produto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "put": {
        "summary": "Atualizar produto",
        "description": "Atualiza os dados de um produto existente",
        "tags": [
          "produtos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProdutoInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Produto atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Produto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT obtido através do endpoint de login"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "erro": {
            "type": "boolean",
            "description": "Indica se houve erro"
          },
          "msg": {
            "type": "string",
            "description": "Mensagem de erro"
          }
        },
        "required": [
          "erro",
          "msg"
        ]
      },
      "UnauthorizedError": {
        "type": "object",
        "properties": {
          "msg": {
            "type": "string",
            "example": "Acesso negado, token não informado!"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "erro": {
            "type": "boolean",
            "example": true
          },
          "msg": {
            "type": "string",
            "description": "Mensagem de validação"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "msg": {
            "type": "string",
            "description": "Mensagem de sucesso"
          }
        }
      },
      "PaginationParams": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "format": "int32",
            "description": "Número máximo de itens a retornar",
            "default": 20,
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "format": "int32",
            "description": "Número de itens a pular",
            "default": 0,
            "minimum": 0
          }
        }
      },
      "Entidade": {
        "type": "object",
        "description": "Descrição da entidade",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "ID único do recurso"
          },
          "nome": {
            "type": "string",
            "description": "Nome do recurso",
            "example": "Exemplo"
          },
          "ativo": {
            "type": "boolean",
            "description": "Status ativo/inativo",
            "default": true
          },
          "data_cadastro": {
            "type": "string",
            "format": "date-time",
            "description": "Data de cadastro"
          }
        },
        "required": [
          "nome"
        ]
      },
      "EntidadeInput": {
        "type": "object",
        "description": "Dados para criação/atualização da entidade",
        "properties": {
          "nome": {
            "type": "string",
            "description": "Nome do recurso"
          },
          "ativo": {
            "type": "boolean",
            "description": "Status ativo/inativo"
          }
        },
        "required": [
          "nome"
        ]
      },
      "EntidadeList": {
        "type": "object",
        "description": "Lista paginada de entidades",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entidade"
            }
          },
          "total": {
            "type": "integer",
            "format": "int32",
            "description": "Total de registros"
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "description": "Limite de registros por página"
          },
          "offset": {
            "type": "integer",
            "format": "int32",
            "description": "Offset da paginação"
          }
        }
      },
      "Produto": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "integer",
            "format": "int32",
            "description": "Código único do produto"
          },
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "ID interno do produto"
          },
          "estoque": {
            "type": "integer",
            "format": "int32",
            "description": "Quantidade em estoque"
          },
          "preco": {
            "type": "number",
            "format": "float",
            "description": "Preço do produto"
          },
          "grupo": {
            "type": "integer",
            "format": "int32",
            "description": "Código da categoria/grupo"
          },
          "descricao": {
            "type": "string",
            "description": "Descrição do produto"
          },
          "num_fabricante": {
            "type": "string",
            "description": "Número do fabricante"
          },
          "num_original": {
            "type": "string",
            "description": "Número original/OEM"
          },
          "sku": {
            "type": "string",
            "description": "SKU do produto"
          },
          "marca": {
            "type": "integer",
            "format": "int32",
            "description": "Código da marca"
          },
          "ativo": {
            "type": "string",
            "enum": [
              "S",
              "N"
            ],
            "description": "Status ativo (S) ou inativo (N)"
          },
          "tipo": {
            "type": "integer",
            "format": "int32",
            "description": "Tipo do produto"
          },
          "class_fiscal": {
            "type": "string",
            "description": "Classificação fiscal"
          },
          "origem": {
            "type": "string",
            "description": "Origem do produto"
          },
          "cst": {
            "type": "string",
            "description": "Código de situação tributária"
          },
          "data_cadastro": {
            "type": "string",
            "format": "date",
            "description": "Data de cadastro"
          },
          "data_recadastro": {
            "type": "string",
            "format": "date-time",
            "description": "Data de recadastro"
          },
          "observacoes1": {
            "type": "string",
            "description": "Observações adicionais 1"
          },
          "observacoes2": {
            "type": "string",
            "description": "Observações adicionais 2"
          },
          "observacoes3": {
            "type": "string",
            "description": "Observações adicionais 3"
          }
        },
        "required": [
          "codigo",
          "descricao"
        ]
      },
      "ProdutoInput": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "integer",
            "format": "int32"
          },
          "estoque": {
            "type": "integer",
            "format": "int32"
          },
          "preco": {
            "type": "number",
            "format": "float"
          },
          "grupo": {
            "type": "integer",
            "format": "int32"
          },
          "descricao": {
            "type": "string"
          },
          "num_fabricante": {
            "type": "string"
          },
          "num_original": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "marca": {
            "type": "integer",
            "format": "int32"
          },
          "ativo": {
            "type": "string",
            "enum": [
              "S",
              "N"
            ]
          },
          "tipo": {
            "type": "integer",
            "format": "int32"
          },
          "class_fiscal": {
            "type": "string"
          },
          "origem": {
            "type": "string"
          },
          "cst": {
            "type": "string"
          },
          "observacoes1": {
            "type": "string"
          },
          "observacoes2": {
            "type": "string"
          },
          "observacoes3": {
            "type": "string"
          }
        },
        "required": [
          "descricao"
        ]
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Não autorizado - Token inválido ou não fornecido",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UnauthorizedError"
            },
            "example": {
              "msg": "Acesso negado, token não informado!"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Requisição inválida",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
