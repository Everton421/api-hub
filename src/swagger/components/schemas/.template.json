{
  "Entidade": {
    "type": "object",
    "description": "Descrição da entidade",
    "properties": {
      "id": {
        "type": "integer",
        "format": "int32",
        "description": "ID único do recurso"
      },
      "nome": {
        "type": "string",
        "description": "Nome do recurso",
        "example": "Exemplo"
      },
      "ativo": {
        "type": "boolean",
        "description": "Status ativo/inativo",
        "default": true
      },
      "data_cadastro": {
        "type": "string",
        "format": "date-time",
        "description": "Data de cadastro"
      }
    },
    "required": ["nome"]
  },
  "EntidadeInput": {
    "type": "object",
    "description": "Dados para criação/atualização da entidade",
    "properties": {
      "nome": {
        "type": "string",
        "description": "Nome do recurso"
      },
      "ativo": {
        "type": "boolean",
        "description": "Status ativo/inativo"
      }
    },
    "required": ["nome"]
  },
  "EntidadeList": {
    "type": "object",
    "description": "Lista paginada de entidades",
    "properties": {
      "data": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Entidade"
        }
      },
      "total": {
        "type": "integer",
        "format": "int32",
        "description": "Total de registros"
      },
      "limit": {
        "type": "integer",
        "format": "int32",
        "description": "Limite de registros por página"
      },
      "offset": {
        "type": "integer",
        "format": "int32",
        "description": "Offset da paginação"
      }
    }
  }
}

